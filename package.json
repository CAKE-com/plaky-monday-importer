{
  "name": "monday-to-plaky-migrator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "bun run scripts/launch.ts",
    "build:app": "next build",
    "start": "bun run scripts/db-migrate.ts --start && next start -H 127.0.0.1",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run scripts/db-migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@trpc/tanstack-react-query": "^11.22.1",
    "cn": "^0.5.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "typescript-eslint": "8.73.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/type-utils": "8.73.0",
    "@typescript-eslint/utils": "8.73.0",
    "@typescript-eslint/typescript-estree": "8.73.0",
    "@typescript-eslint/scope-manager": "8.73.0",
    "@typescript-eslint/types": "8.73.0",
    "@typescript-eslint/visitor-keys": "8.73.0",
    "@typescript-eslint/project-service": "8.73.0",
    "@typescript-eslint/tsconfig-utils": "8.73.0"
  }
